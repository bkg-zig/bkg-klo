{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "cargo build --release" },
  "deploy": {
    "startCommand": "./target/release/bkgclaw gateway --host 0.0.0.0 --port 8787",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}
